---
// The change from one era to the next: 170vh of ground with a stage held on
// screen while the reader passes through it, showing the next era's year in
// both eras' faces and a one-line caption. The engine blends the stage's
// ground and fades its text. Without the engine, the stage is clear and the
// seam's two halves change the skin at the midpoint, which is also what
// reduced motion gets.
import type { Rendered } from "../data/markdown.ts";
import { formatYear } from "../engine/reading.ts";
import { ERAS, type EraId } from "../eras.ts";
import type { SeamFades } from "../tokens/seams.ts";

interface Props {
  index: number;
  from: EraId;
  to: EraId;
  caption: Rendered | undefined;
  fades: SeamFades;
}

const { index, from, to, caption, fades } = Astro.props;
const year = formatYear(ERAS.find((era) => era.id === to)?.from ?? 0);
---

<div
  class="seam"
  data-seam={index}
  data-from={from}
  data-to={to}
  data-fades={JSON.stringify(fades)}
  style={`--seam-from: var(--${from}-ground); --seam-to: var(--${to}-ground)`}
>
  <div class="seam-half" data-theme={from}></div>
  <div class="seam-half" data-theme={to}></div>
  <div class="seam-stage" data-theme={from}>
    <div class="seam-copy">
      <div class="seam-years" aria-hidden="true">
        <span class={`seam-year face-${from}`} data-layer="year-from">
          {year}
        </span>
        <span class={`seam-year face-${to}`} data-layer="year-to">
          {year}
        </span>
      </div>
      {caption && <p class="seam-caption" data-layer="caption" set:html={caption.html} />}
    </div>
  </div>
</div>
