---
// The timeline: an intro, then every era as a chapter with its events on the
// spine, and an empty seam between each pair of eras. The page only draws the
// plan chapters() makes of the validated data.
import "../styles/base.css";
import Chapter from "../components/Chapter.astro";
import FilterPanel from "../components/FilterPanel.astro";
import Hud from "../components/Hud.astro";
import Seam from "../components/Seam.astro";
import { chapters } from "../data/chapters.ts";
import { pageTimeline } from "../data/page.ts";
import { seamFades } from "../tokens/seams.ts";
import { pageTokens } from "../tokens/page.ts";

const { events, vocabularies, seams } = pageTimeline();
const tokens = pageTokens();
const plan = chapters(events);
const first = events[0];
const last = events[events.length - 1];
---

<html lang="en" data-theme="antiquity">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panic &amp; Wonder</title>
    <meta
      name="description"
      content="How people have reacted to the new and the unknown, from omens in antiquity to AI."
    />
  </head>
  <body>
    {/* First in the page, so the Filter button is the first thing Tab reaches, not the last after every row. */}
    <div class="chrome">
      <button
        type="button"
        class="filter-toggle"
        data-skin="reading"
        data-theme="antiquity"
        aria-expanded="false"
        aria-controls="filter-panel"
      >
        Filter<span class="filter-badge" hidden></span>
      </button>
      <Hud />
    </div>
    <header class="intro">
      <h1>Panic &amp; Wonder</h1>
      <p>How people have reacted to the new and the unknown, from omens in antiquity to AI.</p>
      <p class="intro-count">
        {events.length} events{first && last && `, ${first.date} to ${last.date}`}
      </p>
    </header>
    <main>
      {plan.map((chapter, i) => {
        const seam = seams[i];
        return (
          <>
            <Chapter chapter={chapter} vocabularies={vocabularies} />
            {seam && (
              <Seam
                index={i}
                from={seam.from}
                to={seam.to}
                caption={seam.caption}
                fades={seamFades(tokens, seam.from, seam.to)}
              />
            )}
          </>
        );
      })}
    </main>
    <footer data-theme="digital">
      <div class="colophon">
        <p>
          <em>Panic &amp; Wonder</em> is a working title.
        </p>
      </div>
    </footer>
    <FilterPanel vocabularies={vocabularies} chapters={plan} total={events.length} />
    <script>
      import "../client/engine.ts";
      import "../client/filters.ts";
    </script>
  </body>
</html>
