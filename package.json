{
  "name": "panic-and-wonder",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "~4.1.11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "astro check",
    "lint": "astro sync && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "contrast": "vitest run tests/contrast.test.ts",
    "check:quick": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "check": "npm run check:quick && npm run build && npm run build:test && npm run e2e",
    "publish-check": "tsx scripts/publish-check.ts",
    "build:test": "PUBLIC_TEST_API=1 astro build",
    "e2e": "playwright test --pass-with-no-tests --grep-invert @perf && npm run perf",
    "perf": "playwright test --pass-with-no-tests --grep @perf --workers=1"
  }
}
